# 가상환경 (requirements.txt 로 다시 만듦)
.venv/
ocr/
# 캐시 · 임시
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store
runs/
outputs/train/*/weights/
# 학습 캐시 · 중복 산출물 (models/books_obb_best.pt, web/e_unified.onnx 가 원본)
datasets/**/*.cache
models/*.onnx

# 보고서 초안·정리 문서: 사전과제 내용 공개 금지 조건 때문에 공개 저장소에서 제외
docs/

# 외부 공개 데이터 (Open Images 등): 라이선스·용량 때문에 저장소에 올리지 않음 (tools/openimages_books.py로 다시 받음)
datasets/openimages/
datasets/books_obb/images/train/oi_*
datasets/books_obb/labels/train/oi_*

# Liber Deprehensus: 가상환경 · 내려받은 데이터 · 학습 산출물
liber_deprehensus/liber/
liber_deprehensus/.env
liber_deprehensus/data/
liber_deprehensus/*.zip
liber_deprehensus/outputs/*
